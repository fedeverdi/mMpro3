# Apple Developer credentials for notarization
# Create .env file with these values (DO NOT commit .env to git!)

APPLE_ID=tuoindirizzo@email.com
APPLE_ID_PASSWORD=xxxx-xxxx-xxxx-xxxx
# ^ Generate app-specific password at: https://appleid.apple.com/account/manage

# Vercel Edge Config (for license validation)
# Get these from: https://vercel.com/dashboard → Storage → Your Edge Config → Tokens
EDGE_CONFIG=https://edge-config.vercel.com/xxxxxx?token=zzzzzz

# Vercel API Token (for adding licenses via script)
# Get it from: https://vercel.com/account/tokens
VERCEL_API_TOKEN=your_api_token_here

# Vercel Blob Storage (for build uploads)
VERCEL_BLOB_TOKEN=your_blob_token_here
